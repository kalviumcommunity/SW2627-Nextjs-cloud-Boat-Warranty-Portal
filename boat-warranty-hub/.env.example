# ============================================
# .env.example — boAt Warranty Hub
# ============================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to Git!
# ============================================

# ── Database ──
# For Docker development (local Postgres container):
#   This is OVERRIDDEN by docker-compose.yml, so it won't be used in Docker.
#   Set this only for running outside Docker (e.g., connecting to Neon directly).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boat_warranty_hub?schema=public"

# Docker Postgres container credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=boat_warranty_hub

# ── Google Cloud Storage ──
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_BUCKET_NAME=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=./credentials/your-service-account-key.json

# ── Authentication ──
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-string-here-minimum-32-chars
NEXTAUTH_URL=http://localhost:3000

# ── Logging ──
LOG_LEVEL="info"

# ── Environment ──
NODE_ENV="development"
