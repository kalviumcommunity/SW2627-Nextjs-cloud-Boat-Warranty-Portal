# ============================================
# Dockerfile.dev — Development Environment
# boAt Warranty Hub (Next.js 16 + Prisma + Postgres)
# ============================================
# This Dockerfile sets up a development container with:
#   - Hot-reloading via Next.js dev server
#   - Prisma Client generation at build time
#   - Non-root user for security
#   - Entrypoint script for automatic DB migration
#
# Usage:
#   docker compose up --build
# ============================================

FROM node:22-slim

# Install system dependencies required by Prisma and health checks
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends openssl curl && \
    rm -rf /var/lib/apt/lists/*

# Create a non-root user for security
RUN groupadd --system appgroup && \
    useradd --system --gid appgroup --create-home appuser

WORKDIR /app

# Copy dependency manifests first (enables Docker layer caching)
COPY package.json package-lock.json ./

# Install ALL dependencies (dev + prod) since this is a dev image
RUN npm install 

# Copy the rest of the application source
COPY . .

# Generate the Prisma Client at build time
RUN npx prisma generate

# Copy and prepare the entrypoint script
COPY docker-entrypoint.dev.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Set ownership so appuser can write to /app (needed for .next cache, etc.)
RUN chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

EXPOSE 3000

# Use the entrypoint script which handles migrations before starting the app
ENTRYPOINT ["docker-entrypoint.sh"]